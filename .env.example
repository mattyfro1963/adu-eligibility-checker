NEXT_PUBLIC_API_URL=http://localhost:3000
# Prefer MAPBOX_ACCESS_TOKEN. VITE_MAPBOX_ACCESS_TOKEN is accepted as a fallback
# (legacy Vercel / Vite naming) — server-only, never NEXT_PUBLIC_*.
# Server-side geocode + static maps. If the token is URL-restricted in the
# Mapbox dashboard, NEXT_PUBLIC_API_URL must match one of its allowed URLs
# (sent as Referer), or use an unrestricted token. Set in .env.local, then
# restart the dev server.
# MAPBOX_ACCESS_TOKEN=
# VITE_MAPBOX_ACCESS_TOKEN=
# REGRID_API_KEY=

# Sentry (optional — omit to disable reporting)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Optional lead webhooks (Slack/Discord-compatible JSON { content })
# LEAD_WEBHOOK_URL=
# BUILDER_WEBHOOK_URL=

# Eligible-path affiliate outbound URLs (public). Omit or leave blank to hide cards.
# NEXT_PUBLIC_AFFILIATE_TINY_PROJECT_URL=
# NEXT_PUBLIC_AFFILIATE_THDB_PLANS_URL=
# NEXT_PUBLIC_AFFILIATE_JACKERY_URL=
# NEXT_PUBLIC_AFFILIATE_ECOFLOW_URL=
# NEXT_PUBLIC_AFFILIATE_COMPOSTING_TOILET_URL=
# NEXT_PUBLIC_AFFILIATE_TRAILER_CHASSIS_URL=
# NEXT_PUBLIC_AFFILIATE_TUMBLEWEED_URL=
# NEXT_PUBLIC_AFFILIATE_MODULAR_KIT_URL=
