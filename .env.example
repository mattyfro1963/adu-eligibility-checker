NEXT_PUBLIC_API_URL=http://localhost:3000
# Prefer MAPBOX_ACCESS_TOKEN. VITE_MAPBOX_ACCESS_TOKEN is accepted as a fallback
# (legacy Vercel / Vite naming) — server-only, never NEXT_PUBLIC_*.
# MAPBOX_ACCESS_TOKEN=
# VITE_MAPBOX_ACCESS_TOKEN=
# REGRID_API_KEY=

# Sentry (optional — omit to disable reporting)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
